# Copy to .env and edit. Every setting is optional - the app runs fully offline without any of them.

# --- Optional LLM rewrite suggestions (Gemini free tier) -------------------------------------
# Get a key at https://aistudio.google.com/apikey . Leave empty to use the rule-based rewriter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Hybrid matching weights (re-normalised to sum to 1) --------------------------------------
WEIGHT_EMBEDDING=0.5
WEIGHT_TFIDF=0.5
WEIGHT_SKILLS=0.0      # skill overlap still powers the matched/missing-skill view; raise this to also rank by it

# --- Advanced ---------------------------------------------------------------------------------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# JOBS_CSV_PATH=data/jobs_sample.csv
# PRELOAD_MATCHER=0     # skip warming the job index at server start-up
